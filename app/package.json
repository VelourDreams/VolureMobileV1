{
  "name": "volure",
  "private": true,
  "version": "1.0.4",
  "description": "A focused music workspace for DJs and creators.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lottiefiles/dotlottie-web": "^0.79.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.6.2",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^11.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "signalsmith-stretch": "^1.3.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron-builder": "^26.0.12",
    "electron": "^43.3.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "ffmpeg-static@5.3.0": true
  },
  "build": {
    "appId": "com.volure.desktop",
    "productName": "Volure",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../assets",
        "to": "assets"
      }
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "../assets/images/album-art/default1.png",
      "artifactName": "Volure-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Volure"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "VelourDreams",
        "repo": "VolureV1"
      }
    ]
  }
}
